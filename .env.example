# Dues configuration. Copy to .env for local use; never commit .env.
# Nothing here is needed for `pnpm demo:dry` or `pnpm sandbox`: they run on a local chain with generated keys.

# --- network and contract
NEAR_NETWORK=testnet                 # testnet | mainnet | sandbox
DUES_CONTRACT=dues.testnet           # recorded in deployments/testnet.json
# NEAR_RPC_URL=https://test.rpc.fastnear.com

# --- relayer (pays gas for meta-transactions to DUES_CONTRACT only)
RELAYER_ACCOUNT_ID=dues-relayer.testnet
# Comma-separated full-access keys of the relayer account (3 recommended; rotated to avoid nonce clashes).
RELAYER_PRIVATE_KEYS=

# --- watcher (the contract's watcher_id: reports 1Click outcomes, records tx hashes)
WATCHER_ACCOUNT_ID=dues-watcher.testnet
WATCHER_PRIVATE_KEY=

# --- optional
ONECLICK_JWT=                        # partners.near-intents.org; without it 1Click adds a small fee
CRON_SECRET=                         # Vercel Cron bearer token for /api/cron/pull
PULL_KEYS=                           # client.near:ed25519:...  pull-only keys clients granted
API_PORT=3031                        # pnpm api

# --- app build (NEXT_PUBLIC_*), defaults shown
# NEXT_PUBLIC_NETWORK=testnet
# NEXT_PUBLIC_DUES_CONTRACT=dues.testnet
# NEXT_PUBLIC_API_BASE=/api
# NEXT_PUBLIC_CHECKOUT_DRY=true       # 1Click has no testnet; set false on mainnet
